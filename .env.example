DEPLOYMENT_ENV=development
# Vercel supplies VERCEL_ENV; when present it must match DEPLOYMENT_ENV.
VERCEL_ENV=
NEXT_PUBLIC_SITE_URL=
# Safe classes: disabled|development (development), disabled|sandbox (preview), disabled|production (production)
LEAD_PROFILE=development
# Safe classes: disabled|test (development/preview), disabled|production (production)
ANALYTICS_PROFILE=disabled
# Preview/development must be blocked; production may be blocked or allowed after approval.
CRAWL_POLICY=blocked
# Production must be disabled; development/preview may be disabled or protected.
REVIEW_ACCESS=protected
# Temporary production shell only: requires disabled leads/analytics/review and blocked crawling.
PRODUCTION_HOLDING_MODE=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
LEAD_ROUTING_WEBHOOK_URL=
ENABLE_UPLOADS=false
